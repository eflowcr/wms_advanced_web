# LF en todo el repositorio, sin depender de la máquina. Git para Windows trae
# `core.autocrlf=true` de fábrica y normaliza al comparar: un archivo reescrito a CRLF
# aparece limpio para unos y modificado para otros (ya pasó en un PR).
# `text=auto` detecta el texto solo; `eol=lf` fija LF también en el working tree.
# Las reglas de abajo se dejan aunque esta las cubra, para que borrarla no las arrastre.
* text=auto eol=lf

# Archivos que una compuerta compara byte a byte: con CRLF, check-icons.mjs los
# reportaría desincronizados.
projects/design-system/src/icons/icons.generated.ts text eol=lf
projects/design-system/src/icons/custom/*.svg text eol=lf
# La regla 12 (tools/ci/check-i18n.mjs) exige LF en los diccionarios.
projects/shell/public/i18n/**/*.json text eol=lf
