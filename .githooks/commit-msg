#!/bin/sh
# PLN-WMS-003 §7: todo commit asistido por un agente de IA se identifica en sus
# metadatos, con un trailer propio y neutral (sin marca comercial en la historia).
# No detecta asistencia: normaliza lo que dejó la herramienta. Un agente que no deje
# nada agrega `Assisted-By:` él mismo. Ver vault: Integracion Continua.md §10.

msg="$1"
tmp="$msg.hook"

PATRON='^(Co-Authored-By:[[:space:]]*.*(laude|nthropic|opilot|ursor|emini)|Claude-Session:|Assisted-By:)'

if grep -q -E "$PATRON" "$msg" || grep -q -F 'Generated with [Claude Code]' "$msg"; then
  asistido=1
else
  asistido=0
fi

# Fuera toda línea de autoría de herramienta.
grep -v -E "$PATRON" "$msg" > "$tmp" || true
grep -v -F 'Generated with [Claude Code]' "$tmp" > "$msg" || true
rm -f "$tmp"

if [ "$asistido" = "1" ]; then
  # Recorta líneas en blanco del final y anexa el trailer único.
  awk '{l[NR]=$0} END{n=NR; while(n>0 && l[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print l[i]}' "$msg" > "$tmp"
  printf '\nAssisted-By: agente-ia\n' >> "$tmp"
  mv "$tmp" "$msg"
fi