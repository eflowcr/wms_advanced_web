            },
            "development": {
              "tsConfig": "projects/showroom/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/showroom/tsconfig.spec.json",
            "runnerConfig": "vitest.showroom.config.ts",
            "coverage": true
          }
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "ewms",
      "architect": {
        "build": {
