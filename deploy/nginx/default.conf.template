# Consola eWMS: estáticos de dist/shell/browser con el contrato de despliegue y la API del Security Core
# en el mismo origen (/api/v1/security/* -> ${API_UPSTREAM}/*). Ver vault: 02-Arquitectura/Contrato de despliegue
# y 0029 - Despliegue de la consola con nginx.

# Diccionario pedido con ?v=<huella>: inmutable; sin ella, se revalida.
map $arg_v $i18n_cache_control {
    ""      "no-cache";
    default "public, max-age=31536000, immutable";
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # API del Security Core: quita el prefijo y conserva el host público para la verificación de origen.
    location /api/v1/security/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_cookie_path /auth /api/v1/security/auth;
        proxy_read_timeout 30s;
        client_max_body_size 1m;
    }

    # Archivos del build con huella: si cambian, cambian de nombre.
    location ~ "^/(main|chunk|polyfills|styles)-[\w-]+\.(js|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ~ "^/i18n/.+\.json$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control $i18n_cache_control always;
        try_files $uri =404;
    }

    # Cualquier otro archivo (index.html, config.json, fuentes, íconos): se revalida; si falta, 404.
    location ~ "\.[A-Za-z0-9]+$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Rutas de la app sin extensión: responden index.html con 200.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
