{
  "name": "wms-advanced-web",
  "version": "0.1.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "ng serve shell",
    "build": "ng build shell",
    "build:libs": "ng build shared && ng build api-client && ng build core && ng build design-system && ng build showroom && ng build testing && ng build security",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "ng test shell --no-watch && ng test core --no-watch && ng test design-system --no-watch && ng test shared --no-watch && ng test showroom --no-watch && ng test security --no-watch && npm run test:tools",
    "test:tools": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tools/**/*.test.mjs\"",
    "lint": "eslint . --max-warnings=0",
    "lint:tokens": "node tools/ci/check-design-tokens.mjs",
    "lint:icons": "node tools/ci/check-icons.mjs",
    "lint:shortcuts": "node tools/ci/check-shortcuts.mjs",
    "lint:click-budget": "node tools/ci/check-click-budget.mjs",
    "lint:ds": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/ci/check-design-system-only.mjs",
    "lint:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/ci/check-i18n.mjs",
    "lint:comments": "node tools/ci/check-comments.mjs",
    "lint:identifiers": "node tools/ci/check-identifiers.mjs",
    "lint:critical-path": "node tools/ci/check-critical-path.mjs",
    "i18n:format": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/ci/check-i18n.mjs --write",
    "i18n:versions": "node tools/i18n/dictionary-versions.mjs",
    "icons:build": "node tools/icons/build-icons.mjs",
    "vault:check-tokens": "node tools/vault/check-token-names.mjs",
    "vault:check": "node tools/vault/check-vault.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=smoke",
    "e2e:showroom": "playwright test --project=showroom",
    "e2e:domain": "playwright test --project=domain",
    "showroom:capture": "playwright test --config playwright.capture.config.ts",
    "audit:ci": "npm audit --audit-level=high",
    "build:demo": "ng build shell --configuration production,demo"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@jsverse/transloco": "8.4.0",
    "@jsverse/transloco-locale": "8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@jsverse/transloco-keys-manager": "8.1.1",
    "@playwright/test": "1.63.0",
    "@tabler/icons": "3.46.0",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "axe-core": "4.13.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0 <12"
  }
}
