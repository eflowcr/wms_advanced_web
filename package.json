{
  "name": "wms-advanced-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "build": "ng build shell",
    "build:libs": "ng build shared && ng build api-client && ng build core && ng build design-system && ng build showroom && ng build testing",
    "watch": "ng build shell --watch --configuration development",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "ng test shell && ng test design-system && ng test showroom && npm run test:tools",
    "test:tools": "node --test tools/icons/build-icons.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:tokens": "node tools/ci/check-design-tokens.mjs",
    "lint:icons": "node tools/ci/check-icons.mjs",
    "icons:build": "node tools/icons/build-icons.mjs",
    "e2e": "playwright test",
    "audit:ci": "npm audit --audit-level=high"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tabler/icons": "3.46.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "axe-core": "4.13.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0 <12"
  }
}
